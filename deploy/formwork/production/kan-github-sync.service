[Unit]
Description=ClockworkDigital GitHub issues and Kan sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kan-sync
WorkingDirectory=/srv/kan
# Coalesce webhook bursts before reading fresh state, including paused/denied runs.
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/bin/python3 /srv/kan/deploy/formwork/github-sync/sync.py
UMask=0077
NoNewPrivileges=yes
TimeoutStartSec=240
