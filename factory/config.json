{
  "base_branch": "main",
  "remote": "origin",
  "queue_label": "factory",
  "max_rounds": 3,
  "agent_timeout_seconds": 1800,
  "check_timeout_seconds": 900,
  "setup": [
    [
      "pnpm",
      "install",
      "--frozen-lockfile"
    ]
  ],
  "checks": [
    [
      "pnpm",
      "lint"
    ],
    [
      "pnpm",
      "typecheck"
    ],
    [
      "pnpm",
      "test"
    ],
    [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "deploy/formwork/github-sync",
      "-p",
      "test_*.py"
    ],
    [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "factory/tests",
      "-v"
    ]
  ],
  "protected_paths": [
    "factory/*",
    ".agents/*",
    ".codex/*",
    "AGENTS.md",
    ".github/workflows/*",
    "AGENT.md",
    "replit.md"
  ],
  "high_risk_roles": {
    "spec": {
      "model": "gpt-6-astra",
      "effort": "high"
    }
  },
  "roles": {
    "intake": {
      "model": "gpt-6.1-sol",
      "effort": "low"
    },
    "spec": {
      "model": "gpt-6.1-sol",
      "effort": "medium"
    },
    "build": {
      "model": "gpt-6.1-terra",
      "effort": "max"
    },
    "review": {
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    "security": {
      "model": "gpt-6-astra",
      "effort": "high"
    },
    "ui": {
      "model": "gpt-6.1-sol",
      "effort": "medium"
    }
  },
  "risk_guidance": "Treat Formwork gateway identity, tenant/workspace isolation, delegated credentials, department/block checks, GitHub sync mappings and conflict baselines as high risk. Preserve stable UUID identity, eight-hour snapshot expiry, private verification callbacks and no automatic credential renewal. Never propagate deletes or run live sync/deployment. Read deploy/formwork/github-sync/README.md before changing sync. Explicitly target ClockworkDigital/kan for GitHub operations; gh may default to upstream kanbn/kan."
}
